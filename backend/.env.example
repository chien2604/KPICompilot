# ================================================================
# .env.example – Sao chép thành .env và điền thông tin thực tế
# ================================================================

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model mặc định cho text
TEXT_MODEL=openai/gpt-4.1-mini

# Model dùng khi file là ảnh (cần vision)
VISION_MODEL=openai/gpt-4o

# Server
API_SERVICE_PORT=8997
API_HOST=0.0.0.0

# CORS origins (frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://localhost:8080

# Thư mục lưu file tải lên
UPLOAD_DIR=./uploads

# File JSON lưu dữ liệu
STORE_FILE=./data/evidence_store.json

# Kích thước file tối đa (bytes) – mặc định 30MB
MAX_FILE_SIZE=31457280
