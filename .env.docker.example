# Cổng host. Chỉ frontend được mở ra mọi giao diện mạng theo mặc định.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=5191
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8017
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5433

# PostgreSQL. Mật khẩu nên chỉ gồm chữ, số và dấu gạch dưới để dùng an toàn trong URL.
POSTGRES_DB=kpi_government
POSTGRES_USER=kpi
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Xác thực ứng dụng. Tạo bằng: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_64_character_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI. Để trống OPENAI_API_KEY nếu muốn chạy chế độ fallback.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5191
OPENROUTER_APP_NAME=AI KPI Copilot for Government
USE_REAL_EMBEDDINGS=false

# Tổ chức và CORS.
ORGANIZATION_NAME=Ủy ban nhân dân xã Nghĩa Lâm
ORGANIZATION_CODE=UBND_XA_NGHIA_LAM
CORS_ORIGINS=http://localhost:5191

# Tài khoản quản trị dùng cho lệnh khởi tạo một lần.
BOOTSTRAP_ADMIN_NAME=Quản trị viên hệ thống
BOOTSTRAP_ADMIN_EMAIL=admin@example.gov.vn
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_admin_password

